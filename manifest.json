{
  "manifest_version": 3,
  "name": "ChatGPT RTL Local",
  "version": "0.2.1",
  "description": "Locally fixes Hebrew-English text direction in ChatGPT conversations.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

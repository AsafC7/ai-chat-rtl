{
  "manifest_version": 3,
  "name": "RTL for AI Chats",
  "version": "1.0.0",
  "description": "Fixes Hebrew and other right-to-left text direction in ChatGPT, Claude and Gemini. Runs locally, no permissions.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["direction.js", "content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
